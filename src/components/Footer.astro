---
const releaseTag = import.meta.env.PUBLIC_RELEASE_TAG;
---

<footer class="sl-flex">
  <div class="site-footer">
    <a href="/copyright/">Copyright</a>
    <span aria-hidden="true">/</span>
    <a href="/this-wiki-is-not-advice/">This wiki is not financial advice</a>
    <span aria-hidden="true">/</span>
    <a href="/privacy-policy/">Privacy Policy</a>
  </div>
  <div class="version">Version: {releaseTag ?? "dev"}</div>
</footer>

<style>
  @layer starlight.core {
    footer {
      flex-direction: column;
      gap: 0;
    }
  }
  .site-footer {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .site-footer a {
    color: var(--sl-color-gray-3);
  }
  .site-footer a:hover {
    color: var(--sl-color-white);
  }
  .version {
    margin-top: 0.5rem;
    font-size: 0.65rem;
    color: var(--sl-color-gray-4);
    text-align: center;
  }
</style>
